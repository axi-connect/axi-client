# Variables públicas del frontend (copiar a .env.local y ajustar).
# Solo URLs: jamás secretos en NEXT_PUBLIC_* (se filtran al bundle del cliente).

# Backend axi-server (API REST bajo /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# WebSocket (Socket.IO, namespaces /inbox y /channels; path default /socket.io)
NEXT_PUBLIC_WS_BASE_URL=http://localhost:3000

# WhatsApp comercial de axi — OBLIGATORIA: sin ella el build aborta.
# Dígitos con indicativo de país. Un celular colombiano dictado sin indicativo
# (3224970950) se completa solo; los demás formatos (+57 322 497 0950,
# 322-497-0950) también se aceptan.
# De aquí cuelgan los CTA de la landing y /contacto, el banner de vencimiento
# del trial, la pantalla de prueba finalizada y el checklist de canales.
NEXT_PUBLIC_SALES_WHATSAPP=573224970950

# Recuerda registrar el origin de este frontend (p.ej. http://localhost:3001)
# en CORS_ORIGINS del backend para HTTP y WebSocket.

# Origen público del sitio — OBLIGATORIA: sin ella el build aborta.
# De aquí cuelgan metadataBase, los canonical de las rutas públicas, las URLs
# absolutas de Open Graph, el sitemap y los @id del JSON-LD.
# En producción: https://axi-connect.co
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Analítica — OPCIONALES: si faltan, la app se levanta sin medición.
# Un id presente pero mal formado SÍ aborta el build (es peor que ausente:
# aparenta estar configurado y no mide nada).
# Además solo se montan en producción (NODE_ENV=production).
# NEXT_PUBLIC_GA_ID=G-ABC1234567
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Captcha de Cloudflare Turnstile del registro /comenzar.
# OPCIONAL fuera de producción (el backend valida con `noop`). En producción
# es OBLIGATORIA: sin ella el token viaja vacío y toda alta falla con
# «No pudimos verificar que eres una persona» (el widget lo avisa en pantalla).
# Debe corresponder al TURNSTILE_SECRET_KEY del backend.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
